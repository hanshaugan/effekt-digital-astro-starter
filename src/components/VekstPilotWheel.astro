---
import { wheelData, wheelLegendKeys } from '../lib/vekstpilot-wheel';

const cx = 250;
const cy = 250;
const labelR = 168;

function pt(r: number, deg: number) {
  const rad = (deg * Math.PI) / 180;
  return [+(cx + r * Math.cos(rad)).toFixed(2), +(cy + r * Math.sin(rad)).toFixed(2)] as const;
}

/** Arc for textPath. Flip lower segments so letters stay upright along the curve. */
function textArc(mid: number, span = 40) {
  const t0 = mid - span / 2;
  const t1 = mid + span / 2;
  const flip = mid > 5 && mid < 175;
  if (flip) {
    const [x0, y0] = pt(labelR, t1);
    const [x1, y1] = pt(labelR, t0);
    return `M ${x0},${y0} A ${labelR},${labelR} 0 0,0 ${x1},${y1}`;
  }
  const [x0, y0] = pt(labelR, t0);
  const [x1, y1] = pt(labelR, t1);
  return `M ${x0},${y0} A ${labelR},${labelR} 0 0,1 ${x1},${y1}`;
}

const segments = [
  {
    key: 'synlighet',
    label: 'SYNLIGHET',
    color: '#185FA5',
    mid: -54,
    span: 42,
    fontSize: 11,
    path: 'M 254.65,28.05 A 222,222 0 0,1 459.65,176.99 L 342.55,217.77 A 98,98 0 0,0 252.05,152.02 Z',
  },
  {
    key: 'prospektering',
    label: 'PROSPEKTERING',
    color: '#BA7517',
    mid: 18,
    span: 44,
    fontSize: 10.5,
    path: 'M 462.52,185.83 A 222,222 0 0,1 384.22,426.83 L 309.25,328.06 A 98,98 0 0,0 343.82,221.67 Z',
  },
  {
    key: 'salgsaktiviteter',
    label: 'SALGSAKTIVITETER',
    color: '#D85A30',
    mid: 90,
    span: 48,
    fontSize: 9.5,
    path: 'M 376.7,432.3 A 222,222 0 0,1 123.3,432.3 L 194.07,330.47 A 98,98 0 0,0 305.93,330.47 Z',
  },
  {
    key: 'salgsprosess',
    label: 'SALGSPROSESS',
    color: '#534AB7',
    mid: 162,
    span: 42,
    fontSize: 10.5,
    path: 'M 115.78,426.83 A 222,222 0 0,1 37.48,185.83 L 156.18,221.67 A 98,98 0 0,0 190.75,328.06 Z',
  },
  {
    key: 'crm',
    label: 'CRM & TECH',
    color: '#1d9e75',
    mid: 234,
    span: 42,
    fontSize: 11,
    path: 'M 40.35,176.99 A 222,222 0 0,1 245.35,28.05 L 247.95,152.02 A 98,98 0 0,0 157.45,217.77 Z',
  },
] as const;

const labeled = segments.map((seg) => ({
  ...seg,
  tp: textArc(seg.mid, seg.span),
}));

const legendBlurbs: Record<(typeof wheelLegendKeys)[number], string> = {
  synlighet: 'Nettsider, video, webinar og faglig innhold',
  prospektering: 'ICP, lister og riktige kontaktårsaker',
  salgsaktiviteter: 'Dialog, møtebooking og oppfølging',
  salgsprosess: 'Pipeline, metodikk, trening og coaching',
  crm: 'Systemer, automasjon og adopsjon',
};
---

<div class="wheel-layout grid items-center gap-10 lg:grid-cols-[minmax(0,420px)_1fr] lg:gap-16">
  <div class="mx-auto w-full max-w-[min(72vw,280px)] sm:max-w-[320px] md:max-w-[360px] lg:max-w-[420px]">
    <div class="aspect-square w-full">
      <svg
        viewBox="0 0 500 500"
        xmlns="http://www.w3.org/2000/svg"
        class="h-full w-full"
        preserveAspectRatio="xMidYMid meet"
        aria-label="VekstPilot-modellen: strategi i sentrum med fem arbeidsområder"
        role="img"
      >
        <defs>
          {
            labeled.map((seg) => (
              <path id={`tp-${seg.key}`} d={seg.tp} fill="none" />
            ))
          }
        </defs>

        <circle cx="250" cy="250" r="228" fill="none" stroke="#e8e4dc" stroke-width="2" />

        {
          labeled.map((seg) => (
            <g
              class="wheel-seg cursor-pointer transition-opacity hover:opacity-85"
              data-wheel-key={seg.key}
              role="presentation"
            >
              <path d={seg.path} fill={seg.color} />
              <text
                font-family="Inter,sans-serif"
                font-size={seg.fontSize}
                font-weight="700"
                fill="white"
                letter-spacing="0.7"
                class="pointer-events-none select-none"
              >
                <textPath href={`#tp-${seg.key}`} startOffset="50%" text-anchor="middle">
                  {seg.label}
                </textPath>
              </text>
            </g>
          ))
        }

        <g
          class="wheel-seg cursor-pointer transition-opacity hover:opacity-90"
          data-wheel-key="strategi"
          role="presentation"
        >
          <circle cx="250" cy="250" r="92" fill="#ffffff" stroke="#1f5f54" stroke-width="2.5" />
          <text
            x="250"
            y="232"
            text-anchor="middle"
            font-family="Inter,sans-serif"
            font-size="15"
            font-weight="700"
            fill="#1f5f54"
            letter-spacing="1.5"
            class="pointer-events-none select-none"
          >
            STRATEGI
          </text>
          <text
            x="250"
            y="252"
            text-anchor="middle"
            font-family="Inter,sans-serif"
            font-size="7.5"
            font-weight="500"
            fill="#6b7280"
            class="pointer-events-none select-none"
          >
            Mål · Målgruppe
          </text>
          <text
            x="250"
            y="264"
            text-anchor="middle"
            font-family="Inter,sans-serif"
            font-size="7.5"
            font-weight="500"
            fill="#6b7280"
            class="pointer-events-none select-none"
          >
            Posisjonering · KPI
          </text>
          <text
            x="250"
            y="282"
            text-anchor="middle"
            font-family="Inter,sans-serif"
            font-size="9"
            font-weight="700"
            fill="#1f5f54"
            letter-spacing="1"
            class="pointer-events-none select-none"
          >
            VEKSTPILOT
          </text>
        </g>
      </svg>
    </div>
  </div>

  <div>
    <p class="mb-4 border-b-2 border-line pb-2 text-xs font-semibold uppercase tracking-[0.12em] text-accent">
      Fem elementer · klikkbare
    </p>
    <div class="space-y-1">
      <button
        type="button"
        class="wheel-legend-item flex w-full gap-3 border-b border-line py-3 text-left transition hover:text-accent"
        data-wheel-key="strategi"
      >
        <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-[#1f5f54]"></span>
        <span>
          <span class="block font-semibold">Strategi</span>
          <span class="text-sm text-muted">Mål, målgruppe, posisjonering og KPI-er</span>
        </span>
      </button>
      {
        wheelLegendKeys.map((key) => (
          <button
            type="button"
            class="wheel-legend-item flex w-full gap-3 border-b border-line py-3 text-left transition hover:text-accent"
            data-wheel-key={key}
          >
            <span
              class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full"
              style={`background:${wheelData[key].color}`}
            />
            <span>
              <span class="block font-semibold">{wheelData[key].title}</span>
              <span class="text-sm text-muted">{legendBlurbs[key]}</span>
            </span>
          </button>
        ))
      }
    </div>
    <p class="mt-4 text-sm italic text-muted">Klikk på et element for å lese mer</p>
  </div>
</div>

<div
  id="wheel-modal"
  class="fixed inset-0 z-50 hidden overflow-y-auto overscroll-contain bg-black/45 px-4 py-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wheel-modal-title"
>
  <div class="mx-auto flex min-h-[calc(100%-3rem)] max-w-md items-center justify-center">
    <div id="wheel-modal-dialog" class="relative w-full rounded-2xl bg-white p-6 shadow-xl sm:p-8">
      <button
        type="button"
        id="wheel-modal-close"
        class="absolute right-4 top-4 flex h-7 w-7 items-center justify-center rounded-full bg-sand text-muted transition hover:bg-line"
        aria-label="Lukk"
      >
        ✕
      </button>
      <div id="wheel-modal-bar" class="mb-5 h-1 rounded-full"></div>
      <p id="wheel-modal-tag" class="mb-2 text-xs font-semibold uppercase tracking-[0.12em]"></p>
      <h3 id="wheel-modal-title" class="mb-4 text-2xl font-semibold tracking-[-0.04em]"></h3>
      <div id="wheel-modal-body" class="text-sm leading-relaxed text-muted"></div>
    </div>
  </div>
</div>

<script>
  import { wheelData } from '../lib/vekstpilot-wheel';

  const modal = document.getElementById('wheel-modal');
  const wheelDialog = document.getElementById('wheel-modal-dialog');
  const bar = document.getElementById('wheel-modal-bar');
  const tag = document.getElementById('wheel-modal-tag');
  const title = document.getElementById('wheel-modal-title');
  const body = document.getElementById('wheel-modal-body');
  const closeBtn = document.getElementById('wheel-modal-close');

  function openWheel(key) {
    const data = wheelData[key];
    if (!data || !modal || !bar || !tag || !title || !body) return;

    bar.style.background = data.color;
    tag.style.color = data.color;
    tag.textContent = data.tag;
    title.textContent = data.title;
    body.innerHTML = `
      <p class="mb-3">${data.intro}</p>
      <ul class="list-disc space-y-2 pl-5">
        ${data.bullets.map(([strong, rest]) => `<li><strong class="text-ink">${strong}</strong> – ${rest}</li>`).join('')}
      </ul>
    `;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeWheel() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
    modal?.scrollTo(0, 0);
  }

  document.querySelectorAll('[data-wheel-key]').forEach((el) => {
    const key = el.getAttribute('data-wheel-key');
    el.addEventListener('click', () => openWheel(key));
    if (el instanceof HTMLButtonElement) {
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openWheel(key);
        }
      });
    }
  });

  closeBtn?.addEventListener('click', closeWheel);
  modal?.addEventListener('click', (e) => {
    if (!wheelDialog?.contains(e.target)) closeWheel();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeWheel();
  });
</script>

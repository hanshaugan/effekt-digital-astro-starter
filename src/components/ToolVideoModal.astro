---
/** Modal for verktøy-gjennomganger (YouTube, Wistia, Tella, Vimeo). Lazy-loader iframe ved åpning. */
---

<div
  id="tool-video-modal"
  class="fixed inset-0 z-[60] hidden overflow-y-auto overscroll-contain bg-black/55 px-4 py-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tool-video-modal-title"
  hidden
>
  <div class="mx-auto flex min-h-[calc(100%-3rem)] max-w-3xl items-center justify-center">
    <div
      id="tool-video-modal-dialog"
      class="relative w-full overflow-hidden rounded-2xl bg-white shadow-xl"
    >
      <div class="flex items-start justify-between gap-4 border-b border-line px-5 py-4 sm:px-6">
        <div class="min-w-0">
          <p id="tool-video-modal-eyebrow" class="text-xs font-semibold uppercase tracking-wider text-accent">
            Videogjennomgang
          </p>
          <h3 id="tool-video-modal-title" class="mt-1 truncate text-lg font-semibold tracking-[-0.03em] text-ink">
            Video
          </h3>
        </div>
        <button
          type="button"
          id="tool-video-modal-close"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sand text-muted transition hover:bg-line hover:text-ink"
          aria-label="Lukk"
        >
          ✕
        </button>
      </div>
      <div class="relative aspect-video w-full bg-ink">
        <div id="tool-video-modal-player" class="absolute inset-0"></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { resolveVideo } from '../lib/resolveVideo';

  const modal = document.getElementById('tool-video-modal');
  const dialog = document.getElementById('tool-video-modal-dialog');
  const titleEl = document.getElementById('tool-video-modal-title');
  const player = document.getElementById('tool-video-modal-player');
  const closeBtn = document.getElementById('tool-video-modal-close');

  function openVideo(src: string, title: string) {
    if (!modal || !player || !titleEl || !src) return;

    const video = resolveVideo(src);
    titleEl.textContent = title || 'Videogjennomgang';
    player.innerHTML = '';

    if (video.kind === 'iframe') {
      const iframe = document.createElement('iframe');
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.src = video.embedUrl;
      iframe.title = title || 'Videogjennomgang';
      iframe.allow =
        'autoplay; fullscreen; accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.setAttribute('allowfullscreen', '');
      player.appendChild(iframe);
    } else {
      const el = document.createElement('video');
      el.className = 'absolute inset-0 h-full w-full object-contain';
      el.src = video.embedUrl;
      el.controls = true;
      el.playsInline = true;
      player.appendChild(el);
    }

    modal.hidden = false;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeVideo() {
    if (!modal || !player) return;
    modal.hidden = true;
    modal.classList.add('hidden');
    player.innerHTML = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-tool-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-tool-video') || '';
      const title = btn.getAttribute('data-tool-video-title') || 'Videogjennomgang';
      openVideo(src, title);
    });
  });

  closeBtn?.addEventListener('click', closeVideo);
  modal?.addEventListener('click', (e) => {
    if (!dialog?.contains(e.target as Node)) closeVideo();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeVideo();
  });
</script>

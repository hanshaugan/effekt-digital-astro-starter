---
const { eyebrow, title, text } = Astro.props;
---
<div class="mb-10 grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-14">
  <div>
    {eyebrow && (
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
    )}
    <h2 class="max-w-3xl text-4xl font-semibold leading-[1.08] tracking-[-0.05em] sm:text-5xl lg:text-6xl">
      {title}
    </h2>
  </div>
  {
    text && (
      <p
        class:list={[
          'max-w-2xl text-xl leading-relaxed text-muted',
          eyebrow ? 'lg:pt-[2.15rem]' : '',
        ]}
      >
        {text}
      </p>
    )
  }
</div>

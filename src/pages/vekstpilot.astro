---
import BaseLayout from '../layouts/BaseLayout.astro';
import VekstPilotWheel from '../components/VekstPilotWheel.astro';
import VekstPilotBookModal from '../components/VekstPilotBookModal.astro';
import { absoluteUrl } from '../lib/site';
import {
  organizationSchema,
  schemaGraph,
  webPageSchema,
  websiteSchema,
} from '../lib/schema';

const title = 'VekstPilot – Effekt Digital';
const description =
  'VekstPilot hjelper B2B-bedrifter med å skape flere relevante salgsmuligheter – gjennom strategi, innhold, prospektering, salgsaktiviteter og CRM.';
const url = absoluteUrl('/vekstpilot/');
const schema = schemaGraph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({ title, description, url }),
);

const diagSteps = [
  [
    'Kartlegging (90 min)',
    'Vi går gjennom strategien og de fem elementene med deg og relevante personer i teamet. Strukturert samtale med konkrete spørsmål.',
  ],
  [
    'Kort oppsummering',
    'Du får en kort skriftlig oppsummering med hovedfunn og anbefalte neste steg – ikke en full rapport.',
  ],
  [
    'Neste steg',
    'Vi avklarer om dere fortsetter selv, går videre til Analyse, eller starter rådgivning/gjennomføring der det haster mest.',
  ],
];

const packages = [
  {
    badge: 'Inngang',
    name: 'Diagnose',
    desc: '90 min kartlegging, kort oppsummering og anbefalte neste steg. Beløpet kan krediteres mot Analyse, Rådgivning eller Gjennomføring innen 3 måneder.',
    price: 'kr 4 900',
    note: 'Krediteres innen 3 mnd ved videre samarbeid',
    cta: 'Book nå →',
    featured: false,
    book: true,
  },
  {
    badge: 'Dypere',
    name: 'Analyse',
    desc: 'Grundigere analyse, prioriteringer og konkret 90-dagers handlingsplan for de områdene som betyr mest.',
    price: 'Fra kr 14 900',
    note: 'Engangs – etter omfang',
    cta: 'Ta kontakt →',
    featured: false,
    book: false,
  },
  {
    badge: 'Løpende',
    name: 'Rådgivning',
    desc: 'Sparring, prioritering, salgsprosess, KPI-er og koordinering. To rådgivningsmøter per måned + kort async mellom møtene. Operativ gjennomføring prises separat.',
    price: 'Fra kr 9 900/mnd',
    note: 'Avgrenset til sparring – ikke leveranse',
    cta: 'Ta kontakt →',
    featured: true,
    book: false,
  },
  {
    badge: 'Operativt',
    name: 'Gjennomføring',
    desc: 'Avtalte leveranser: prospektering, møtebooking, CRM, kampanjer, innhold eller video – spesifisert i tilbud.',
    price: 'Tilbud etter omfang',
    note: 'Aktiviteter, ansvar og kapasitet avtales',
    cta: 'Ta kontakt →',
    featured: false,
    book: false,
  },
];
---
<BaseLayout {title} {description} {schema}>
  <main>
  <!-- Hero -->
  <section>
    <p class="mb-8 inline-flex rounded-full bg-accent-soft px-4 py-2 text-xs font-semibold uppercase tracking-wider text-accent">
      VekstPilot – av Effekt Digital
    </p>
    <h1 class="max-w-2xl text-5xl font-semibold leading-[1.1] tracking-[-0.05em] sm:text-6xl">
      Flere salgsmuligheter. En mer systematisk salgsprosess.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
      VekstPilot hjelper B2B-bedrifter med å skape flere relevante salgsmuligheter – og følge dem opp til de blir
      kunder. Vi kombinerer strategi, innhold, prospektering, salgsaktiviteter og CRM i én helhetlig modell. Du får
      hjelp med det du trenger: rådgivning, konkrete tiltak eller operativ gjennomføring.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a href="#diagnose" class="inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink/90">
        Start med en diagnose
      </a>
      <a href="#modellen" class="text-sm text-muted transition hover:text-ink">Se modellen →</a>
    </div>
  </section>

  <!-- Dark strip -->
  <section class="mt-28 rounded-[2rem] bg-ink px-8 py-10 text-white lg:px-12 lg:py-12">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <h2 class="text-3xl font-semibold leading-tight tracking-[-0.03em] sm:text-4xl">
        De fleste B2B-selskaper feiler ikke fordi de mangler ett verktøy. De feiler fordi{' '}
        <span class="text-accent-soft">ingenting henger sammen.</span>
      </h2>
      <p class="text-sm leading-relaxed text-white/55 sm:text-base">
        Synlighet uten oppfølging gir lite. Prospektering uten CRM gir kaos. God teknologi uten salgsprosess blir
        hyllesystem. VekstPilot starter med strategien og forbedrer de områdene som har størst betydning for din
        bedrift – ikke som fem obligatoriske faser, men som én sammenhengende salgsmotor.
      </p>
    </div>
  </section>

  <!-- Modellen -->
  <section id="modellen" class="mt-28">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Modellen</p>
    <h2 class="mb-4 max-w-xl text-4xl font-semibold tracking-[-0.04em]">
      Én strategi. Fem elementer. Flere salgsmuligheter.
    </h2>
    <p class="mb-12 max-w-xl text-muted">
      VekstPilot kobler sammen synlighet, prospektering, salgsaktiviteter, salgsprosess og teknologi. Vi starter med
      strategien og forbedrer de områdene som har størst betydning for din bedrift. Klikk på hvert element for å lese
      mer.
    </p>
    <VekstPilotWheel />
    <p class="mt-8 max-w-2xl text-sm text-muted">
      Ledelse, kompetanse og prestasjonskultur går på tvers av modellen. VideoKlar støtter synlighet og innhold som
      spesialisert videoleveranse –{' '}
      <a
        href="https://videoklar.no"
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-ink underline decoration-line underline-offset-4 hover:text-accent"
      >
        se videoklar.no
      </a>
      .
    </p>
  </section>

  <!-- Diagnose -->
  <section id="diagnose" class="mt-28 rounded-[2rem] border border-line bg-white p-8 lg:p-12">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Slik starter vi</p>
        <h2 class="mb-4 text-4xl font-semibold tracking-[-0.04em]">VekstPilot Diagnose</h2>
        <p class="mb-8 max-w-md text-muted">
          Et strukturert intervju på 90 minutter der vi kartlegger strategien og de fem elementene – og gir deg en
          kort oppsummering med anbefalte neste steg.
        </p>
        <button
          type="button"
          class="js-open-vekstpilot-book inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink/90"
        >
          Book Diagnose – kr 4 900
        </button>
        <p class="mt-3 text-sm text-muted">
          Beløpet kan krediteres mot Analyse, Rådgivning eller Gjennomføring innen 3 måneder.
        </p>
      </div>
      <div class="space-y-6">
        {
          diagSteps.map(([stepTitle, stepDesc], i) => (
            <div class="flex gap-4">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
                {i + 1}
              </span>
              <div>
                <p class="font-medium">{stepTitle}</p>
                <p class="mt-1 text-sm leading-relaxed text-muted">{stepDesc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Samarbeidsformer -->
  <section id="samarbeid" class="mt-28">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Samarbeidsformer</p>
    <h2 class="mb-4 max-w-xl text-4xl font-semibold tracking-[-0.04em]">Velg nivå etter behov</h2>
    <p class="mb-10 max-w-md text-muted">
      Du kan starte med Diagnose og bygge videre med Analyse, Rådgivning eller Gjennomføring – uten å kjøpe alt.
    </p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        packages.map((pkg) => (
          <article
            class:list={[
              'flex flex-col rounded-[1.75rem] border p-7',
              pkg.featured ? 'border-line bg-ink text-white' : 'border-line bg-white',
            ]}
          >
            <p class="mb-3 text-[0.7rem] font-semibold uppercase tracking-wider text-accent">{pkg.badge}</p>
            <h3 class="text-xl font-semibold tracking-[-0.02em]">{pkg.name}</h3>
            <p class:list={['mt-2 flex-1 text-sm leading-relaxed', pkg.featured ? 'text-white/50' : 'text-muted']}>
              {pkg.desc}
            </p>
            <p class="mt-5 text-2xl font-semibold tracking-[-0.02em]">{pkg.price}</p>
            <p class:list={['mt-1 text-xs', pkg.featured ? 'text-white/35' : 'text-muted']}>{pkg.note}</p>
            {
              pkg.book ? (
                <button
                  type="button"
                  class:list={[
                    'js-open-vekstpilot-book mt-5 text-left text-sm font-semibold transition hover:opacity-70',
                    pkg.featured ? 'text-accent-soft' : 'text-accent',
                  ]}
                >
                  {pkg.cta}
                </button>
              ) : (
                <a
                  href="/kontakt/"
                  class:list={[
                    'mt-5 text-sm font-semibold transition hover:opacity-70',
                    pkg.featured ? 'text-accent-soft' : 'text-accent',
                  ]}
                >
                  {pkg.cta}
                </a>
              )
            }
          </article>
        ))
      }
    </div>
  </section>

  <!-- Møtebooking -->
  <section class="mt-28 rounded-[2rem] border border-line bg-sand-2 p-8 lg:p-12">
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Modul</p>
    <h2 class="mb-4 max-w-xl text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">
      VekstPilot Møtebooking
    </h2>
    <p class="max-w-2xl text-muted">
      Målrettet B2B-prospektering, kvalifisering, personlig oppfølging, booking og CRM-logging. Tilbys primært som
      avgrenset pilot – ikke som ubegrenset volumtjeneste. Omfang og pris avtales etter målgruppe og kapasitet.
    </p>
    <a
      href="/kontakt/"
      class="mt-8 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink/90"
    >
      Ta kontakt om møtebooking
    </a>
  </section>

  <!-- CTA -->
  <section class="mt-28 rounded-[2rem] border border-line bg-white p-8 text-center lg:p-14">
    <h2 class="text-4xl font-semibold tracking-[-0.04em]">Klar for å se hva som faktisk stopper veksten?</h2>
    <p class="mx-auto mt-4 max-w-md text-muted">
      Start med en diagnose. 90 minutter gir deg et klarere bilde av salgsmotoren din – og konkrete neste steg.
    </p>
    <button
      type="button"
      class="js-open-vekstpilot-book mt-8 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink/90"
    >
      Book VekstPilot Diagnose
    </button>
  </section>
  </main>

  <VekstPilotBookModal />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { absoluteUrl } from '../../lib/site';
import {
  organizationSchema,
  schemaGraph,
  webPageSchema,
  websiteSchema,
} from '../../lib/schema';

const title = 'Tjenester – Effekt Digital';
const description =
  'Fra synlighet til salg: VekstPilot, VideoKlar og CRM/Sales Tech for B2B-bedrifter som vil skape flere salgsmuligheter.';
const url = absoluteUrl('/tjenester/');
const schema = schemaGraph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({ title, description, url }),
);

const areas = [
  {
    href: '/vekstpilot/',
    external: false,
    badge: 'VekstPilot',
    title: 'Flere salgsmuligheter. En mer systematisk salgsprosess.',
    text: 'Diagnose/Analyse, rådgivning, prospektering, møtebooking, salgsutvikling og gjennomføring.',
    price: 'Diagnose fra 4 900 kr',
    cta: 'Utforsk VekstPilot →',
    featured: true,
  },
  {
    href: 'https://videoklar.no',
    external: true,
    badge: 'VideoKlar',
    title: 'Video som bygger tillit og skaper salgsmuligheter.',
    text: 'Lederprofilering, kundereferanser, webinarer, produktdemoer, salgsvideo og opplæring.',
    price: 'Fra 11 900 kr/mnd',
    cta: 'Gå til videoklar.no →',
    featured: false,
  },
  {
    href: '/crm-helsesjekk/',
    external: false,
    badge: 'CRM og Sales Tech',
    title: 'Teknologi som gjør salgsarbeidet enklere.',
    text: 'CRM-rådgivning, implementering, systemrydding, AI/automatisering, integrasjoner, adopsjon og rapportering.',
    price: 'Pris etter avtale',
    cta: 'Start med CRM-helsesjekk →',
    featured: false,
  },
];

const collaboration = [
  [
    'Kartlegging',
    'Diagnose eller Analyse: forstå nåsituasjon, flaskehalser og hva som bør prioriteres først.',
  ],
  [
    'Rådgivning',
    'Løpende sparring på strategi, salgsprosess, KPI-er og koordinering – uten at jeg tar over leveransen.',
  ],
  [
    'Gjennomføring',
    'Avtalte operative leveranser: prospektering, møtebooking, CRM, kampanjer, innhold eller video.',
  ],
];

const challenges = [
  'Lite synlighet hos riktige beslutningstakere',
  'For få kvalifiserte salgsmuligheter i pipeline',
  'Tilfeldig prospektering og oppfølging',
  'CRM som ikke brukes – eller for mange verktøy',
  'Salgsprosess uten tydelig metodikk og coaching',
  'Video og innhold som ikke er koblet til salg',
];
---
<BaseLayout {title} {description} {schema}>
  <main>
    <section>
      <p class="mb-5 inline-flex rounded-full bg-accent-soft px-4 py-2 text-sm font-semibold text-accent">
        Tjenester · Effekt Digital
      </p>
      <h1 class="max-w-3xl text-5xl font-semibold leading-[1.05] tracking-[-0.06em] sm:text-6xl">
        Fra synlighet til salg. Og fra strategi til handling.
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-relaxed text-muted">
        Jeg hjelper B2B-bedrifter med å bli mer synlige, skape relevante salgsmuligheter og utvikle
        salgsprosesser som fungerer. Gjennom rådgivning, innhold, målrettede salgsaktiviteter og smart bruk
        av teknologi.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kontakt/" class="rounded-full bg-ink px-6 py-4 text-sm font-semibold text-white">
          Book en rådgivningsprat
        </a>
        <a href="#tjenesteomraader" class="rounded-full border border-line px-6 py-4 text-sm font-semibold">
          Utforsk tjenestene
        </a>
      </div>
    </section>

    <section id="tjenesteomraader" class="mt-28">
      <SectionHeading
        eyebrow="Tre hovedområder"
        title="Velg inngang etter problemet."
        text="Du trenger ikke kjøpe alt. Start der det haster mest – så bygger vi videre der det gir effekt."
      />
      <div class="grid gap-4 md:grid-cols-3">
        {
          areas.map((area) => (
            <a
              href={area.href}
              target={area.external ? '_blank' : undefined}
              rel={area.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'group flex flex-col rounded-[1.75rem] border border-line p-7 transition hover:border-accent',
                area.featured ? 'bg-ink text-white' : 'bg-white',
              ]}
            >
              <p
                class:list={[
                  'text-xs font-semibold uppercase tracking-wider',
                  area.featured ? 'text-accent-soft' : 'text-accent',
                ]}
              >
                {area.badge}
              </p>
              <h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em]">{area.title}</h2>
              <p class:list={['mt-4 flex-1 text-sm leading-relaxed', area.featured ? 'text-white/60' : 'text-muted']}>
                {area.text}
              </p>
              <p class:list={['mt-5 text-sm font-semibold', area.featured ? 'text-white/80' : 'text-ink']}>
                {area.price}
              </p>
              <span
                class:list={[
                  'mt-4 inline-block text-sm font-semibold',
                  area.featured ? 'text-accent-soft' : 'text-accent',
                ]}
              >
                {area.cta}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-28">
      <SectionHeading
        title="Slik kan vi samarbeide"
        text="Tre samarbeidsformer – ikke et krav om å kjøpe alle tre."
      />
      <div class="grid gap-4 md:grid-cols-3">
        {
          collaboration.map(([title, text], i) => (
            <article class="rounded-[1.75rem] border border-line bg-white p-7">
              <p class="font-bold text-accent">0{i + 1}</p>
              <h3 class="mt-6 text-2xl font-semibold tracking-[-0.04em]">{title}</h3>
              <p class="mt-4 text-muted">{text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-28 rounded-[2rem] bg-accent-soft p-8 lg:p-12">
      <h2 class="max-w-3xl text-4xl font-semibold tracking-[-0.06em]">Typiske utfordringer</h2>
      <ul class="mt-8 grid gap-3 text-lg text-muted md:grid-cols-2">
        {challenges.map((item) => <li>• {item}</li>)}
      </ul>
    </section>

    <section class="mt-28 rounded-[2rem] border border-line bg-white p-8 text-center lg:p-14">
      <h2 class="text-4xl font-semibold tracking-[-0.04em]">La oss finne ut hvor du bør starte.</h2>
      <p class="mx-auto mt-4 max-w-md text-muted">
        En kort prat er nok til å avklare om VideoKlar, VekstPilot eller CRM/Sales Tech er riktig første steg.
      </p>
      <a
        href="/kontakt/"
        class="mt-8 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink/90"
      >
        Book en rådgivningsprat
      </a>
    </section>
  </main>
</BaseLayout>
